# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Phase 1: Supabase (needed now) -----------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Phase 1: seed test business (needed now) -------------------------------
# This becomes the one business row every later test script talks to.
SEED_BUSINESS_NAME=Queen City Comfort
SEED_OWNER_NAME=Steven
# Your own cell, in E.164 format (e.g. +19805551234). Required for db:seed.
SEED_OWNER_CELL=
# The shop line customers call. Leave blank until you have a real one to test with.
SEED_FORWARD_NUMBER=
SEED_TIMEZONE=America/New_York
SEED_TRADE=HVAC
SEED_CITY=Charlotte
SEED_SERVICE_AREA_ZIPS=28277,28226,28210
SEED_HOURS=Mon-Fri 8am-6pm, emergency calls after hours
SEED_WARRANTY=1 year parts and labor on all repairs
SEED_LICENSING=
SEED_DEPOSIT_CENTS=8900
SEED_DEPOSIT_LABEL=diagnostic fee
SEED_AVG_TICKET_CENTS=67500

# --- Phase 2+: Twilio (not needed until Phase 2) ----------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

# --- Phase 3+: Anthropic (not needed until Phase 3) -------------------------
ANTHROPIC_API_KEY=

# --- Phase 4+: Stripe (not needed until Phase 4) ----------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Phase 5+: owner agent (not needed until Phase 5) -----------------------
# Your own cell — clients' owners are told to text you here for anything
# the owner agent can't do yet.
SUPPORT_CELL=

# --- Phase 6+: weekly report cron (not needed until Phase 6) ----------------
# Any random string. Vercel sends this as a Bearer token when it triggers
# the cron job, so only Vercel (or someone with this value) can fire it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Optional -----------------------------------------------------------
# Comma-separated caller ID prefixes/numbers for Google's agentic-calling range.
GOOGLE_AGENT_CALLER_IDS=
# Public URL of the deployed app, used for Stripe Checkout's redirect pages.
# Leave as localhost until Phase 7's deploy gives you a real URL.
APP_BASE_URL=http://localhost:3000
